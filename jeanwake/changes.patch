+        if (AudioStateMonitor.isVoiceConfirmed()) {
+            // Do not compete with an active voice conversation.
+            bg.postDelayed(this::resumePortuguese, 8_000L);
+            return;
+        }
+        if (!startPortugueseDetector()) stopSelf();
+    }
